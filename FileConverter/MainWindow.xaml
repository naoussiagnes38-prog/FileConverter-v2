<Window x:Class="FileConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileConverter"
        mc:Ignorable="d"
        Title="File Converter"
        Icon="AppIcon.ico"
        Height="750"
        Width="1000"
        MinHeight="440"
        MinWidth="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid x:Name="LayoutRoot" Background="{DynamicResource WindowBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition x:Name="ShellTopRow" Height="Auto"/>
            <RowDefinition x:Name="ShellContentRow" Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border x:Name="SidebarBorder" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <DockPanel x:Name="SidebarDock" LastChildFill="True">

                <!-- SIDEBAR HEADER -->
                <StackPanel x:Name="SidebarHeader" DockPanel.Dock="Top"
                            Margin="15,20">

                    <Image x:Name="SidebarLogo" Source="AppIcon.ico" Width="38" Height="38" Margin="0,0,0,12" Visibility="Collapsed"/>
                    <TextBlock x:Name="SidebarName" Text="FILE CONVERTER"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="19"
                               FontWeight="Bold"
                               Margin="5,10,5,25"/>

                    <Button x:Name="SidebarToggleButton" Content="☰"
                            Click="ToggleSidebar_Click"
                            Height="40"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            FontSize="18"
                            Cursor="Hand"/>
                </StackPanel>

                <!-- SIDEBAR FOOTER -->
                <TextBlock x:Name="SidebarVersion" DockPanel.Dock="Bottom"
                           Text="File Converter v1.0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="5,20"/>

                <!-- NAVIGATION -->
                <ScrollViewer x:Name="NavigationScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">

                    <WrapPanel x:Name="NavigationPanel">

                        <Button x:Name="ConvertButton"
                                Content="⇄    Convert"
                                Style="{StaticResource NavigationButton}"
                                Background="{DynamicResource SelectedItemBrush}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Click="Convert_Click"/>
                        <Button x:Name="TranslateButton"
                                Content="文    Translate"
                                Style="{StaticResource NavigationButton}"
                                Click="Translate_Click"/>

                        <Button x:Name="CompressButton"
                                Content="▣    Compress"
                                Style="{StaticResource NavigationButton}"
                                Click="Compress_Click"/>
                        <Button x:Name="EncryptButton"
                                Content="◆    Encrypt"
                                Style="{StaticResource NavigationButton}"
                                Click="Encrypt_Click"/>
                        <Button x:Name="ManualButton"
                                Content="?    Manual"
                                Style="{StaticResource NavigationButton}"
                                Click="Manual_Click"/>
                        <Button x:Name="HistoryButton"
                                Content="◷    History"
                                Style="{StaticResource NavigationButton}"
                                Click="History_Click"/>

                    </WrapPanel>

                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid x:Name="MainContentGrid" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
              Background="{DynamicResource WindowBackgroundBrush}">

            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopBarRow" Height="75"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">

                <Grid x:Name="TopBarContent" Margin="20,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="PageTitle"
                               Text="{DynamicResource L_Convert}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="{DynamicResource L_Settings}"
                            Click="Settings_Click"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Padding="15,9"
                            Cursor="Hand"
                            VerticalAlignment="Center"/>

                </Grid>
            </Border>

            <!-- CONTENT HOST -->
            <ContentControl x:Name="PageHost"
                            Grid.Row="1"
                            Margin="12"
                            Background="{DynamicResource WindowBackgroundBrush}"/>

        </Grid>

    </Grid>

</Window>
